# Development compose template. Copy to docker-compose.yml (gitignored) and
# adjust ports/paths in .env. The app service matches Makefile/AGENTS.md
# assumptions: service laravel.test, source bind-mounted at /var/www/html,
# sail user (uid from WWWUSER). Horizon and cron run inside the container via
# supervisord (see docker/8.5/supervisord.conf) - no separate worker services.
services:
    laravel.test:
        build:
            context: ./docker/8.5
            dockerfile: Dockerfile
            args:
                WWWGROUP: '${WWWGROUP}'
        image: nntmux-dev/php85
        extra_hosts:
            - 'host.docker.internal:host-gateway'
        ports:
            - '${APP_PORT:-80}:80'
        environment:
            WWWUSER: '${WWWUSER}'
            TZ: '${APP_TIMEZONE:-UTC}'
        volumes:
            - '.:/var/www/html'
        networks:
            - nntmux
        healthcheck:
            test: ["CMD", "curl", "-f", "http://localhost:80"]
            interval: 10s
            timeout: 5s
            retries: 5
            start_period: 30s
        depends_on:
            mariadb:
                condition: service_healthy
            redis:
                condition: service_healthy
    mariadb:
        image: 'mariadb:12.3'
        environment:
            TZ: '${APP_TIMEZONE:-UTC}'
            MYSQL_ROOT_PASSWORD: '${DB_PASSWORD}'
            MYSQL_ROOT_HOST: '%'
            MYSQL_DATABASE: '${DB_DATABASE}'
            MYSQL_USER: '${DB_USERNAME}'
            MYSQL_PASSWORD: '${DB_PASSWORD}'
            MYSQL_ALLOW_EMPTY_PASSWORD: 'yes'
        command:
            --max_allowed_packet=128M
            --group_concat_max_len=16384
            --max_connections=200
        volumes:
            - 'mariadb:/var/lib/mysql'
        networks:
            - nntmux
        healthcheck:
            test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
            interval: 10s
            retries: 3
            timeout: 5s
            start_period: 15s
    redis:
        image: 'redis:alpine'
        environment:
            TZ: '${APP_TIMEZONE:-UTC}'
        volumes:
            - 'redis:/data'
        networks:
            - nntmux
        healthcheck:
            test: ["CMD", "redis-cli", "ping"]
            retries: 3
            timeout: 5s
    manticore:
        image: manticoresearch/manticore:28.4.4
        profiles:
            - manticore
        environment:
            TZ: '${APP_TIMEZONE:-UTC}'
            EXTRA: 1
        restart: always
        ulimits:
            nproc: 65535
            nofile:
                soft: 65535
                hard: 65535
            memlock:
                soft: -1
                hard: -1
        volumes:
            - 'manticore:/var/lib/manticore/data'
            - './config/manticore.conf:/etc/manticoresearch/manticore.conf'
        networks:
            - nntmux
        healthcheck:
            test: ["CMD", "wget", "-qO-", "http://localhost:9308/"]
            interval: 15s
            timeout: 5s
            retries: 3
            start_period: 15s
        deploy:
            resources:
                limits:
                    memory: 1g
    mailpit:
        image: 'axllent/mailpit:latest'
        ports:
            - '${FORWARD_MAILPIT_PORT:-1025}:1025'
            - '${FORWARD_MAILPIT_DASHBOARD_PORT:-8025}:8025'
        networks:
            - nntmux
networks:
    nntmux:
        driver: bridge
volumes:
    mariadb:
    redis:
    manticore:
