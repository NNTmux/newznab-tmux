---
# Copy outside the checkout, fill in, then encrypt the whole file with ansible-vault.
# Never pass actual secret values on a command line.
nntmux_secrets:
  APP_KEY: 'base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64'
  ADMIN_USER: administrator
  ADMIN_EMAIL: admin@example.com
  ADMIN_PASS: REPLACE_WITH_AT_LEAST_12_CHARACTERS
  DB_DATABASE: nntmux
  DB_USERNAME: nntmux
  DB_PASSWORD: REPLACE_WITH_RANDOM_DATABASE_PASSWORD
  REDIS_PASSWORD: REPLACE_WITH_RANDOM_REDIS_PASSWORD
  NNTP_SERVER: news.example.com
  NNTP_PORT: '563'
  NNTP_SSLENABLED: 'true'
  NNTP_USERNAME: REPLACE_WITH_NNTP_USERNAME
  NNTP_PASSWORD: REPLACE_WITH_NNTP_PASSWORD
  ELASTICSEARCH_USER: nntmux
  ELASTICSEARCH_PASS: REPLACE_IF_USING_ELASTICSEARCH
  AWS_ACCESS_KEY_ID: REPLACE_WITH_BACKUP_ACCESS_KEY
  AWS_SECRET_ACCESS_KEY: REPLACE_WITH_BACKUP_SECRET_KEY
  RESTIC_PASSWORD: REPLACE_WITH_RANDOM_BACKUP_ENCRYPTION_PASSWORD
  # MAIL_USERNAME, MAIL_PASSWORD and metadata API credentials may be added here.
