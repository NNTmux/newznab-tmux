environment = "production"
hostname = "indexer.example.com"
location = "fsn1"
network_zone = "eu-central"
server_type = "ccx33"
repository_url = "ghcr.io/REPLACE-WITH-LOWERCASE-OWNER/nntmux"
vault_address = "https://vault.example.com"
vault_secret_path = "secret/data/nntmux/production"
admin_cidrs = ["203.0.113.10/32"]
ssh_public_key = "ssh-ed25519 REPLACE_WITH_PUBLIC_KEY"
