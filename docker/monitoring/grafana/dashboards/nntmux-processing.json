    {
      "id": 5,
      "type": "timeseries",
      "title": "Match rates",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "nntmux-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nntmux-prometheus"
          },
          "expr": "100 * nntmux_predb_matched_releases / clamp_min(nntmux_releases, 1)",
          "legendFormat": "PreDB matched",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nntmux-prometheus"
          },
          "expr": "100 * nntmux_releases_with_nfo / clamp_min(nntmux_releases_with_nfo + on() nntmux_processing_backlog{type=\"nfo\"}, 1)",
          "legendFormat": "NFO found",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nntmux-prometheus"
          },
          "expr": "100 * nntmux_releases_renamed / clamp_min(nntmux_releases_renamed + on() nntmux_processing_backlog{type=\"renames\"}, 1)",
          "legendFormat": "Renamed",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
