      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nntmux-prometheus"
          },
          "expr": "delta(nntmux_releases[1h])",
          "legendFormat": "releases/hour",
          "refId": "A",
          "range": true,
          "instant": false
